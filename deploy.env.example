# deploy-optiplex.sh: where the watch-only page runs. Copy to deploy.env (not in the repository) and fill in.
# Quote every value: an unquoted backslash is lost.
OPTIPLEX_HOST="192.168.x.x"                 # the box's address on the network
OPTIPLEX_USER="user"                        # its SSH user (key login)
OPTIPLEX_DIR='C:\services\fpv-spotter'      # the app's folder there
VIEW_PORT="5190"
VIEW_TRACKS="fril-27-second-track"          # comma-separated track folders to copy and serve
